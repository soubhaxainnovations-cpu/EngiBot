# EngiBot Backend Environment Variables

# Runtime Environment (development | production)
# In development (ENVIRONMENT=development), local SQLite (backend/chatbot.db) is permitted for offline coding.
# In production (ENVIRONMENT=production or RENDER=true), persistent PostgreSQL is STRICTLY ENFORCED to prevent data loss.
ENVIRONMENT=development
ENFORCE_PERSISTENT_DB=false

# Security & CORS Settings
SESSION_SECRET=your_super_secret_session_encryption_key_here
ALLOWED_ORIGINS=https://engibot.pages.dev,https://engibot.vercel.app,http://localhost:5173

# Database Configuration (PostgreSQL / SQLite)
# For Render / Supabase / Neon: Use session pooler mode (port 5432) with sslmode=require
# In production, DATABASE_URL pointing to a persistent PostgreSQL instance is MANDATORY.
# Example Supabase session pooler connection string:
# DATABASE_URL=postgresql://postgres.xxx:your_password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Persistent Object Storage (AWS S3, Cloudflare R2, Supabase Storage)
# If empty, uploads are stored locally in backend/uploads/ (ephemeral on free Render)
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_ENDPOINT_URL=
S3_PUBLIC_DOMAIN=

# AI Provider Configurations
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
AI_PROVIDER=auto

# Email OTP Delivery (HTTPS APIs to bypass Render free SMTP port blocks)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=EngiBot Assistant

# Standard SMTP Configuration (Local / Non-Blocked Hosts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=EngiBot Assistant
SMTP_FROM_EMAIL=
