# EngiBot Backend Environment Variables

# SMTP Configuration for Email OTP Login
# For Gmail: 
# 1. Use your standard Gmail address in SMTP_USER
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Paste the App Password into SMTP_PASSWORD (no spaces required)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=EngiBot Assistant
SMTP_FROM_EMAIL=

# Local Trained Model (Ollama) Configuration
# AI_PROVIDER: 'auto', 'ollama', or 'openrouter'
AI_PROVIDER=auto
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=engibot-model
OLLAMA_TEMPERATURE=0.7

# OpenRouter AI Cloud Fallback Configuration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Database Configuration (PostgreSQL / SQLite)
# Leave blank to default to local SQLite (chatbot.db)
# Or provide your PostgreSQL connection string:
# Local PostgreSQL:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/engibot
# Cloud PostgreSQL (Supabase / Neon / Render / AWS RDS):
# DATABASE_URL=postgresql://user:password@ep-host.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=


